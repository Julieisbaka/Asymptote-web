{
  "name": "asymptote-web",
  "version": "0.0.4",
  "description": "Run the Asymptote vector graphics language entirely in the browser via WebAssembly.",
  "type": "module",
  "main": "./dist/asymptote-web.js",
  "module": "./dist/asymptote-web.js",
  "types": "./dist/asymptote-web.d.ts",
  "exports": {
    ".": {
      "import": "./dist/asymptote-web.js",
      "types": "./dist/asymptote-web.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --project tsconfig.build.json",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "npm run build && bash ./wasm/build.sh"
  },
  "keywords": [
    "asymptote",
    "vector-graphics",
    "wasm",
    "webassembly",
    "svg",
    "browser"
  ],
  "license": "LGPL-3.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
