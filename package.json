{
  "name": "asymptote-web",
  "version": "0.3.1-dev",
  "description": "Run the Asymptote vector graphics language entirely in the browser via WebAssembly.",
  "keywords": [
    "asymptote",
    "vector-graphics",
    "wasm",
    "webassembly",
    "svg",
    "browser"
  ],
  "type": "module",
  "main": "./dist/asymptote-web.js",
  "module": "./dist/asymptote-web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/asymptote-web.js"
    },
    "./asymptote.js": {
      "types": "./dist/asymptote-js.d.ts",
      "import": "./dist/asymptote.js",
      "default": "./dist/asymptote.js"
    },
    "./asymptote.wasm": {
      "types": "./dist/asset-url.d.ts",
      "default": "./dist/asymptote.wasm"
    },
    "./asy.data": {
      "types": "./dist/asset-url.d.ts",
      "default": "./dist/asy.data"
    },
    "./asygl.js": {
      "types": "./dist/asset-url.d.ts",
      "default": "./dist/asygl.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Julieisbaka/Asymptote-web.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "LGPL-3.0-only",
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --project tsconfig.build.json && node scripts/write-package-types.mjs",
    "dev": "vite",
    "predev": "npm run verify:package",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && bash ./wasm/build.sh && npm run verify:package",
    "prepack:experimental": "npm run build && bash ./wasm/build.sh candidate && npm run verify:package"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.7",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
