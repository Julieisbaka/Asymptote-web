{
  "name": "asymptote-web",
  "version": "0.1.0",
  "description": "Run the Asymptote vector graphics language entirely in the browser via WebAssembly.",
  "type": "module",
  "main": "./dist/asymptote-web.js",
  "module": "./dist/asymptote-web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/asymptote-web.js",
      "types": "./dist/index.d.ts"
    },
    "./asymptote.js": "./dist/asymptote.js",
    "./asymptote.wasm": "./dist/asymptote.wasm",
    "./asy.data": "./dist/asy.data",
    "./asygl.js": "./dist/asygl.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --project tsconfig.build.json",
    "dev": "vite",
    "predev": "npm run verify:package",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && bash ./wasm/build.sh && npm run verify:package"
  },
  "keywords": [
    "asymptote",
    "vector-graphics",
    "wasm",
    "webassembly",
    "svg",
    "browser"
  ],
  "license": "LGPL-3.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1"
  }
}